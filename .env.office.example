# Copy to .env.office ON THE OFFICE SERVER and fill in real values.
# Never commit .env.office.

NODE_ENV=production
PORT=5000

# --- MySQL (used by both the mysql container and the backend) ---
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=finsync360
MYSQL_USER=finsync
MYSQL_PASSWORD=
# MYSQL_HOST/MYSQL_PORT are set by docker-compose.office.yml — do not set here.

# Shared DB: schema changes must come from a deliberate deploy, never from
# whichever developer's backend booted last.
MYSQL_SYNC_ALTER=false
MYSQL_SYNC_FORCE=false

# --- Secrets: generate fresh, do not reuse your local dev values ---
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRE=30d
JWT_REFRESH_EXPIRE=90d
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=
SESSION_SECRET=

DESKTOP_AGENT_API_KEY=

# --- Testing conveniences ---
LICENSE_ENFORCEMENT=false
LOG_LEVEL=info
SWAGGER_ENABLED=true
BCRYPT_ROUNDS=12

# --- Fill in only if the feature is being tested ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
EMAIL_USER=
EMAIL_PASS=
