# Production Environment Configuration for FinSync360 Mobile App
# Backend: self-hosted Hostinger VPS (Ubuntu 24.04, MySQL 8) behind Nginx + TLS.

# Backend API Configuration
REACT_APP_API_URL=https://api.aiminfocom.com/api
API_BASE_URL=https://api.aiminfocom.com/api
WEBSOCKET_URL=wss://api.aiminfocom.com
TALLY_AGENT_URL=wss://api.aiminfocom.com/tally-agent

# ML Service Configuration (Now deployed and operational)
REACT_APP_ML_SERVICE_URL=https://finsync-ml-2bba4152b555.herokuapp.com/api/v1
ML_SERVICE_URL=https://finsync-ml-2bba4152b555.herokuapp.com/api/v1

# Frontend URL (for reference)
FRONTEND_URL=https://finsync-frontend-nextjs-fbce311426ec.herokuapp.com

# Environment
NODE_ENV=production

# App Configuration
APP_NAME=FinSync360
APP_VERSION=1.0.0

# Security
# NOTE: JWT_SECRET and ENCRYPTION_KEY intentionally live ONLY in the server's
# backend/.env. Anything bundled into an APK can be extracted from it, so server
# secrets must never appear here.

# Features
ENABLE_BIOMETRICS=true
ENABLE_OFFLINE_MODE=true
ENABLE_REAL_TIME_SYNC=true
ENABLE_ML_FEATURES=true

# Debug (Disabled in production)
DEBUG_MODE=false
ENABLE_NETWORK_LOGGING=false

# Production specific settings
API_TIMEOUT=10000
RETRY_ATTEMPTS=3
CACHE_DURATION=300000
